{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://funnyfiction.com/polis/schemas/v0.1/identity.schema.json",
  "title": "PoLiS Identity Component",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema", "id", "type"],
  "properties": {
    "$schema": { "const": "https://funnyfiction.com/polis/schemas/v0.1/identity.schema.json" },
    "schema": { "const": "polis.identity/v0.1" },
    "id": { "type": "string", "format": "uri", "minLength": 1 },
    "type": { "type": "string", "minLength": 1 },
    "name": { "type": "string" },
    "displayName": { "type": "string" },
    "description": { "type": "string" },
    "tags": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "origin": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "world": { "type": "string" },
        "platform": { "type": "string" },
        "location": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    }
  }
}
