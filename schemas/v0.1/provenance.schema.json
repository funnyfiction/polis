{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://funnyfiction.com/polis/schemas/v0.1/provenance.schema.json",
  "title": "PoLiS Provenance Component",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema", "data"],
  "properties": {
    "$schema": { "const": "https://funnyfiction.com/polis/schemas/v0.1/provenance.schema.json" },
    "schema": { "const": "polis.provenance/v0.1" },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "type"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "type": { "type": "string", "minLength": 1 },
              "description": { "type": "string" },
              "uri": { "type": "string", "format": "uri" },
              "createdAt": { "type": "string", "format": "date-time" }
            }
          }
        },
        "rights": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["subject", "status"],
            "properties": {
              "subject": { "type": "string", "minLength": 1 },
              "status": { "enum": ["allowed", "restricted", "prohibited", "unknown"] },
              "license": { "type": "string" },
              "conditions": { "type": "array", "items": { "type": "string" } },
              "evidence": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
