{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://polis.live/schemas/component/v0.1.0/schema.json",
  "title": "PoLiS Generic Component Envelope",
  "description": "Base envelope for optional PoLiS component documents. Specialized component schemas should constrain data.",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema", "data"],
  "properties": {
    "$schema": { "const": "https://polis.live/schemas/component/v0.1.0/schema.json" },
    "schema": { "type": "string", "pattern": "^polis\\.[a-z0-9][a-z0-9.-]*/v[0-9]+(?:\\.[0-9]+)?$" },
    "data": { "type": "object", "additionalProperties": true }
  }
}
