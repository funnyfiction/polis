{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://funnyfiction.com/polis/schemas/v0.1/visual-identity.schema.json",
  "title": "PoLiS Visual Identity Component",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema", "data"],
  "properties": {
    "$schema": { "const": "https://funnyfiction.com/polis/schemas/v0.1/visual-identity.schema.json" },
    "schema": { "const": "polis.visual-identity/v0.1" },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "description": { "type": "string" },
        "characteristics": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "face": { "type": "string" },
            "hair": { "type": "string" },
            "eyes": { "type": "string" },
            "body": { "type": "string" },
            "distinctiveFeatures": { "type": "array", "items": { "type": "string" } },
            "visualInvariants": { "type": "array", "items": { "type": "string" } }
          }
        },
        "style": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "preferred": { "type": "array", "items": { "type": "string" } },
            "avoid": { "type": "array", "items": { "type": "string" } }
          }
        },
        "references": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["asset", "purpose"],
            "properties": {
              "asset": { "type": "string", "minLength": 1 },
              "purpose": { "type": "string", "minLength": 1 },
              "priority": { "type": "integer", "minimum": 1 },
              "view": { "type": "string" },
              "notes": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
